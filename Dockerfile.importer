FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY client/package.json ./client/
COPY importer/package.json ./importer/
RUN npm ci --workspace importer --include-workspace-root=false

COPY importer ./importer

ENV PORT=8787
EXPOSE 8787

CMD ["npm", "start", "-w", "importer"]