{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --registry=${NOTERAIN_NPM_REGISTRY:-https://registry.npmjs.org/} --replace-registry-host=always",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}