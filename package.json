{
  "name": "noterain",
  "version": "0.0.1",
  "description": "A modern web-based MIDI player and piano learning tool",
  "author": "",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install:deps": "node scripts/install-dependencies.mjs",
    "dev": "npm run dev -w client",
    "build": "npm run build -w client && npm run typecheck:api",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "preview": "npm run preview -w client",
    "lint": "npm run lint -w client",
    "test": "npm run test -w client",
    "format": "prettier --write \"client/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/postgres": "^0.10.0"
  }
}
